         scaler = getattr(self, "scaler", None)
 
@@ -802,6 +811,10 @@ class FSDPEngine(BaseEngine):
             else:
                 self.optimizer.step()
 
+        if _deferred_opt:
+            offload_fsdp_optimizer(self.optimizer)
+            log_gpu_memory_usage("After deferred offload_fsdp_optimizer", logger=None)
+
         if self._qat_enabled:
             from verl.utils.qat.core import invalidate_all_scales
 
@@ -1072,6 +1085,15 @@ class FSDPEngine(BaseEngine):
         return self.module.disable_adapter()
 
 
+def _defer_optimizer_load() -> bool:
+    """Opt-in: hold Adam state on CPU during forward/backward.
+
+    Off by default so this only changes runs that ask for it via
+    ``VERL_DEFER_OPTIMIZER_LOAD=1``. See EngineTrainModeCtx._context_switch.
+    """
+    return os.environ.get("VERL_DEFER_OPTIMIZER_LOAD", "0") == "1"
+
+
 class EngineEvalModeCtx(BaseEngineCtx):
     def __init__(self, engine: FSDPEngine, **kwargs):
         super().__init__(engine=engine, mode="eval", **kwargs)
@@ -1102,6 +1124,34 @@ class EngineTrainModeCtx(BaseEngineCtx):
     def __init__(self, engine: FSDPEngine, **kwargs):
         super().__init__(engine=engine, mode="train", **kwargs)
 
+    def _context_switch(self, device):
+        """Keep Adam state off the GPU until optimizer_step().
+
+        The default loads params *and* optimizer state on train-mode entry and holds
+        both for all of ``train_batch``. But train_batch is
+        zero_grad -> forward_backward_batch -> optimizer_step, and only the last of
+        those touches the optimizer -- by which point the activations are gone. On
+        Qwen3-30B-A3B / 16xH100 step 1 already peaks at ~72GB of the card's 79GB with
+        no optimizer state allocated yet (Adam allocates lazily on the first .step()),
+        so step 2 -- the first step where fp32 exp_avg/exp_avg_sq exist -- OOMs inside
+        backward(). The two peaks never need to overlap; this stops them doing so.
+
+        Exit (device == "cpu") still goes through the base implementation, which
+        offloads both, and offload_fsdp_optimizer is a no-op on empty/already-CPU state.
+        """
+        if device == "cpu" or not _defer_optimizer_load():
+            return super()._context_switch(device)
+        if self.disable_auto_offload:
+            return
+        if not self.engine.is_param_offload_enabled and not self.engine.is_optimizer_offload_enabled:
+            return
+        self.engine.to(
+            device=device,
+            model=self.engine.is_param_offload_enabled,
+            optimizer=False,
+            grad=self.engine.is_param_offload_enabled,
+        )
+
     def __enter__(self):
         assert isinstance(self.engine, FSDPEngine)
         super().__enter__()
