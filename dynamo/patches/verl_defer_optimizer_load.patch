@@ -770,6 +770,15 @@ class FSDPEngine(BaseEngine):
         """
         assert self.optimizer_config.clip_grad is not None
 
+        # Adam state is only needed here, once forward_backward_batch has freed every
+        # activation. Under VERL_DEFER_OPTIMIZER_LOAD the train-mode context left it on
+        # CPU, so bring it in for the step and send it straight back.
+        _deferred_opt = _defer_optimizer_load() and self._is_offload_optimizer and self.optimizer is not None
