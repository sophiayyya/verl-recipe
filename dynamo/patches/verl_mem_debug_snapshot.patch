Target: verl @ 6cbca9ce7208100d11b4d1b06eccf098cc9e76aa
Apply:  cd $VERL_CHECKOUT && git apply recipe/dynamo/patches/<this file>

VERL_MEM_DEBUG=1: record CUDA allocation history during the actor update and dump a torch memory snapshot on OOM.

Diagnostic only; off by default. Snapshot goes to $VERL_MEM_DEBUG_DIR (default /tmp) as oom_rank<N>.pickle.
diff --git a/verl/workers/engine/base.py b/verl/workers/engine/base.py
index 161faed0..b1b6e388 100644
--- a/verl/workers/engine/base.py
+++ b/verl/workers/engine/base.py
@@ -124,7 +124,38 @@ class BaseEngine:
         maybe_fix_3d_position_ids(data)
 
         self.optimizer_zero_grad()
-        outputs = self.forward_backward_batch(data, loss_function, forward_only=False)
+        # VERL_MEM_DEBUG: attribute the actor-update peak. Reasoning from config alone
+        # could not explain ~58 GB of the 72 GB seen on Qwen3-30B-A3B/16xH100, so record
+        # allocation stacks and dump them when the OOM actually fires. The snapshot is
+        # readable with torch.cuda._memory_viz; the summary goes straight to the log.
+        _mem_debug = os.environ.get("VERL_MEM_DEBUG", "0") == "1"
+        if _mem_debug:
+            import torch
+
+            torch.cuda.memory._record_memory_history(max_entries=200000)
+        try:
+            outputs = self.forward_backward_batch(data, loss_function, forward_only=False)
+        except Exception:
+            if _mem_debug:
+                import traceback
+
+                import torch
+
+                rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+                out_dir = os.environ.get("VERL_MEM_DEBUG_DIR", "/tmp")
+                try:
+                    os.makedirs(out_dir, exist_ok=True)
+                    torch.cuda.memory._dump_snapshot(f"{out_dir}/oom_rank{rank}.pickle")
+                except Exception:
+                    traceback.print_exc()
+                print(f"[VERL_MEM_DEBUG rank={rank}] snapshot -> {out_dir}/oom_rank{rank}.pickle", flush=True)
+                print(torch.cuda.memory_summary(abbreviated=False), flush=True)
+            raise
+        finally:
+            if _mem_debug:
+                import torch
+
+                torch.cuda.memory._record_memory_history(enabled=None)
         grad_norm = self.optimizer_step()
         if self.is_mp_src_rank_with_outputs():
             assert "grad_norm" not in outputs["metrics"]
