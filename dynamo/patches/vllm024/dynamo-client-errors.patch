-from vllm.exceptions import (
-    VLLMClientError,
-    VLLMNotFoundError,
-    VLLMUnprocessableEntityError,
-)
+from vllm import exceptions as vllm_exceptions
 
 from dynamo.llm.exceptions import HttpError
 
+# vLLM 0.24 predates the common client-error hierarchy introduced in 0.27.
+# Catch only explicit request errors on both versions, never arbitrary engine
+# ValueError/RuntimeError failures, which must remain server errors.
+if hasattr(vllm_exceptions, "VLLMClientError"):
+    VLLM_CLIENT_ERRORS = (vllm_exceptions.VLLMClientError,)
+else:
+    VLLM_CLIENT_ERRORS = (
+        vllm_exceptions.VLLMValidationError,
+        vllm_exceptions.VLLMNotFoundError,
+    )
+
+VLLM_UNPROCESSABLE_ERRORS = (
+    (vllm_exceptions.VLLMUnprocessableEntityError,)
+    if hasattr(vllm_exceptions, "VLLMUnprocessableEntityError")
+    else ()
+)
+
 
-def vllm_client_error_to_http_error(exc: VLLMClientError) -> HttpError:
+def vllm_client_error_to_http_error(exc: Exception) -> HttpError:
     """Preserve the HTTP status assigned by vLLM's client-error hierarchy."""
-    if isinstance(exc, VLLMUnprocessableEntityError):
+    if isinstance(exc, VLLM_UNPROCESSABLE_ERRORS):
         status_code = 422
-    elif isinstance(exc, VLLMNotFoundError):
+    elif isinstance(exc, vllm_exceptions.VLLMNotFoundError):
         status_code = 404
     else:
         status_code = 400
