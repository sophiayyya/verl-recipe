--- /dev/null
+++ b/components/src/dynamo/vllm/tests/test_client_error_compat.py
@@ -0,0 +1,109 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Request streaming must work with both old and new vLLM error hierarchies."""
+
+import asyncio
+import importlib.util
+from types import SimpleNamespace
+
+import pytest
+import vllm
+from vllm.exceptions import VLLMNotFoundError, VLLMValidationError
+
+from dynamo.llm.exceptions import HttpError
+from dynamo.vllm import errors
+from dynamo.vllm.handlers import _translate_vllm_client_errors
+
+pytestmark = [
+    pytest.mark.pre_merge,
+    pytest.mark.gpu_0,
+    pytest.mark.unit,
+    pytest.mark.vllm,
+    pytest.mark.core,
+]
+
+
+@pytest.mark.asyncio
+async def test_installed_backend_streams_without_new_error_base():
+    async def generate():
+        yield {"token_ids": [42]}
+        yield {"token_ids": [43], "finish_reason": "stop"}
+
+    assert [chunk async for chunk in _translate_vllm_client_errors(generate())] == [
+        {"token_ids": [42]},
+        {"token_ids": [43], "finish_reason": "stop"},
+    ]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("error", "status"),
+    [(VLLMValidationError("bad input"), 400), (VLLMNotFoundError("missing"), 404)],
+)
+async def test_installed_request_errors_keep_http_status(error, status):
+    async def generate():
+        yield {"token_ids": [42]}
+        raise error
+
+    output = _translate_vllm_client_errors(generate())
+    assert await anext(output) == {"token_ids": [42]}
+    with pytest.raises(HttpError) as caught:
+        await anext(output)
+    assert caught.value.code == status
+    assert caught.value.message == str(error)
+    assert caught.value.__cause__ is error
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "error",
+    [RuntimeError("engine failed"), ValueError("internal"), asyncio.CancelledError()],
+)
+async def test_internal_errors_and_cancellation_are_not_client_errors(error):
+    async def generate():
+        raise error
+        yield  # pragma: no cover - establishes an async generator
+
+    with pytest.raises(type(error)) as caught:
+        await anext(_translate_vllm_client_errors(generate()))
+    assert caught.value is error
+
+
+@pytest.mark.parametrize(
+    ("kind", "status"), [("client", 400), ("missing", 404), ("unprocessable", 422)]
+)
+def test_new_error_hierarchy_keeps_status(monkeypatch, kind, status):
+    class ClientError(Exception):
+        pass
+
+    class NotFoundError(ClientError):
+        pass
+
+    class UnprocessableError(ClientError):
+        pass
+
+    monkeypatch.setattr(
+        vllm,
+        "exceptions",
+        SimpleNamespace(
+            VLLMClientError=ClientError,
+            VLLMNotFoundError=NotFoundError,
+            VLLMUnprocessableEntityError=UnprocessableError,
+        ),
+    )
+    spec = importlib.util.spec_from_file_location(
+        "_isolated_error_compat", errors.__file__
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    error = {
+        "client": ClientError,
+        "missing": NotFoundError,
+        "unprocessable": UnprocessableError,
+    }[kind]("request")
+    assert isinstance(error, module.VLLM_CLIENT_ERRORS)
+    assert not isinstance(RuntimeError(), module.VLLM_CLIENT_ERRORS)
+    translated = module.vllm_client_error_to_http_error(error)
+    assert translated.code == status
+    assert translated.message == "request"
